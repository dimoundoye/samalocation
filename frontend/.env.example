# Production Environment Variables for Front-end
# Set these in your hosting platform (Netlify, Vercel, etc.)

VITE_API_URL=https://your-backend-url.onrender.com/api
VITE_TURNSTILE_SITE_KEY=your-cloudflare-site-key

# Paiement du loyer en ligne + onglet portefeuille propriétaire (désactivé par défaut)
VITE_RENT_ONLINE_PAYMENT_ENABLED=false
