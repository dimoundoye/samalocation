# Supabase credentials for Docker backup
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASS=your-supabase-db-password

# Monitoring (Umami Analytics - optional)
UMAMI_DB_USER=umami_user
UMAMI_DB_PASSWORD=your-secure-umami-db-password
UMAMI_DB_NAME=umami
UMAMI_APP_SECRET=your-secure-umami-app-secret

