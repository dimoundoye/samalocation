# ==============================================================================
# Modèle des variables d'environnement de Production (Backend)
# Copiez ce contenu dans un fichier `backend/.env` sur votre serveur
# et remplacez les valeurs par vos vraies clés de production.
# ==============================================================================

# --- APPLICATION & SERVEUR ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://samalocation.com
APP_DOMAIN=samalocation.com

# --- SÉCURITÉ & AUTHENTIFICATION ---
JWT_SECRET=generer_une_cle_secrete_tres_longue_et_aleatoire
JWT_EXPIRES_IN=30d
PDF_OWNER_PASSWORD=generer_un_mot_de_passe_robuste_pour_proteger_les_pdf

# --- BASE DE DONNÉES (Supabase) ---
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_USER=postgres.votre_id_projet
DB_PASS=votre_mot_de_passe_supabase
DB_NAME=postgres
DB_PORT=6543
DB_SSL=true
SUPABASE_DB_PASS=votre_mot_de_passe_supabase

# --- SERVICES EXTERNES & STOCKAGE (Cloudinary, Cloudflare, AI) ---
CLOUDINARY_URL=cloudinary://votre_cle_api:votre_secret@votre_cloud_name
TURNSTILE_SECRET_KEY=votre_cle_secrete_cloudflare_turnstile
GEMINI_API_KEY=votre_cle_api_google_gemini
GROQ_API_KEY=votre_cle_api_groq
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile
GROQ_MODEL_SPEED=llama-3.1-8b-instant

# --- EMAILS (Resend & SMTP Fallback) ---
RESEND_API_KEY=re_votre_cle_resend
RESEND_FROM="Samalocation <noreply@samalocation.com>"

SMTP_HOST=mail.samalocation.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@samalocation.com
SMTP_PASS=votre_mot_de_passe_boite_mail
SMTP_FROM="Samalocation <noreply@samalocation.com>"

# --- PAIEMENTS (PayDunya) ---
PAYDUNYA_MASTER_KEY=votre_master_key
PAYDUNYA_PUBLIC_KEY=live_public_votre_cle
PAYDUNYA_PRIVATE_KEY=live_private_votre_cle
PAYDUNYA_TOKEN=votre_token_paydunya
PAYDUNYA_MODE=live
PAYDUNYA_REAL_FEE_RATE=0.02
PAYMENT_FEE_CLIENT=0.025

# Notifications push (Web Push / VAPID) — générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@samalocation.com
